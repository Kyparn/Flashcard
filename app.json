{
  "expo": {
    "name": "Bar Flashcard",
    "slug": "bar-flashcard-svin",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simon.barflashcard"
    },
    "android": {
      "package": "com.simon.barflashcard",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1923"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6d9f4614-339a-4861-9a1b-edc804930f67"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
